rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Reads users/{uid}.role to verify admin status.
    // No circular problem: when a user reads their OWN doc, isOwner() short-circuits
    // before isAdmin() is evaluated.
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Fields that only the server-side Admin SDK may set.
    // Listed inline in both functions below (Firestore Rules has no top-level constants).
    // Uses keys().hasAny() on create — request.resource.data is the full new document.
    // Uses diff().affectedKeys() on update — checks only the changed fields.

    function noProtectedFieldsOnCreate() {
      return !request.resource.data.keys().hasAny([
        "role", "status", "accessStatus", "plan", "isAdmin",
        "adminNote",
        "blockedAt", "blockedBy", "blockedReason",
        "deletedAt", "deletedBy", "deleteReason",
        "accessExpiresAt", "accessGrantedBy", "couponGrantedBy"
      ]);
    }

    function userProtectedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny([
                 "role", "status", "accessStatus", "plan", "isAdmin",
                 "adminNote",
                 "blockedAt", "blockedBy", "blockedReason",
                 "deletedAt", "deletedBy", "deleteReason",
                 "accessExpiresAt", "accessGrantedBy", "couponGrantedBy"
               ]);
    }

    // ── users ───────────────────────────────────────────────────────────────
    // Normal users: read/create/update own doc only.
    //   create: protected fields MUST NOT be present in the new document.
    //   update: protected fields MUST NOT be among the changed fields.
    // Admin: full write access via Admin SDK (bypasses rules) or isAdmin() path.
    match /users/{userId} {
      allow read:   if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && noProtectedFieldsOnCreate();
      allow update: if (isSignedIn() && isOwner(userId) && userProtectedFieldsUnchanged())
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ── projects ────────────────────────────────────────────────────────────
    // App writes: userId field (projectsService.ts sets userId = auth.uid on create).
    // Currently localStorage-backed. Rules apply when migrated to Firestore.
    // On update: userId ownership field must not change.
    match /projects/{projectId} {
      allow read:   if isSignedIn() && isOwner(resource.data.userId);
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    // ── rooms ───────────────────────────────────────────────────────────────
    // MIGRATION REQUIREMENT: roomsService.create() must write ownerId = auth.uid
    // when rooms are moved from localStorage to Firestore.
    match /rooms/{roomId} {
      allow read:   if isSignedIn() && isOwner(resource.data.ownerId);
      allow create: if isSignedIn() && isOwner(request.resource.data.ownerId);
      allow update: if isSignedIn() && isOwner(resource.data.ownerId)
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && isOwner(resource.data.ownerId);
    }

    // ── messages ────────────────────────────────────────────────────────────
    // MIGRATION REQUIREMENT: messages must include userId = auth.uid
    // when moved from localStorage to Firestore.
    match /messages/{messageId} {
      allow read:   if isSignedIn() && isOwner(resource.data.userId);
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    // ── decisionMemos ───────────────────────────────────────────────────────
    // Live Firestore writes active today (decisionMemosService.save()).
    // userId is set by the service; ownership field locked on update.
    match /decisionMemos/{memoId} {
      allow read:   if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
    }

    // ── coupons ─────────────────────────────────────────────────────────────
    // Normal users CAN read (needed to validate early-access codes).
    // Only admins can create/update/delete.
    match /coupons/{couponId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── couponRedemptions ───────────────────────────────────────────────────
    match /couponRedemptions/{redemptionId} {
      allow read:           if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create:         if isSignedIn() && isOwner(request.resource.data.userId);
      allow update, delete: if isAdmin();
    }

    // ── waitlist ────────────────────────────────────────────────────────────
    // Public create (pre-auth). Field restriction blocks arbitrary data injection.
    match /waitlist/{entryId} {
      allow create: if request.resource.data.keys()
                       .hasOnly(["email", "name", "createdAt", "source", "status"]);
      allow read, update, delete: if isAdmin();
    }

    // ── feedback ────────────────────────────────────────────────────────────
    match /feedback/{feedbackId} {
      allow create:              if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── admin-only collections ───────────────────────────────────────────────
    match /adminLogs/{docId} {
      allow read, write: if isAdmin();
    }

    match /systemConfig/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
